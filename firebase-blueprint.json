{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A customer quote or consultation request for UAE company setup and visas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the lead",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Prospect full name",
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "description": "Prospect email address",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone or WhatsApp number",
          "maxLength": 50
        },
        "company": {
          "type": "string",
          "description": "Existing or proposed company name",
          "maxLength": 200
        },
        "jurisdiction": {
          "type": "string",
          "description": "Mainland, Free Zone, Undecided, or Offshore",
          "maxLength": 50
        },
        "activityType": {
          "type": "string",
          "description": "Business activity sector",
          "maxLength": 200
        },
        "visasNeeded": {
          "type": "number",
          "description": "Number of residency visas required"
        },
        "message": {
          "type": "string",
          "description": "Client specific notes or inquiry details",
          "maxLength": 5000
        },
        "budget": {
          "type": "string",
          "description": "Estimated budget bracket",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Workflow status of lead",
          "enum": ["New", "Contacted", "In Progress", "Converted", "Closed"],
          "maxLength": 50
        },
        "pipedriveStatus": {
          "type": "string",
          "description": "Pipedrive CRM synchronization state",
          "enum": ["synced", "pending", "failed"],
          "maxLength": 50
        },
        "pipedriveDealId": {
          "type": "string",
          "description": "Assigned Pipedrive deal ID",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of submission",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "description": "Internal CRM consultant notes",
          "maxLength": 2000
        }
      },
      "required": ["id", "name", "email", "phone", "jurisdiction", "activityType", "visasNeeded", "status", "createdAt"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Audit log of dispatched customer confirmation or admin notification emails",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for email log",
          "maxLength": 128
        },
        "leadId": {
          "type": "string",
          "description": "Associated lead ID",
          "maxLength": 128
        },
        "recipient": {
          "type": "string",
          "description": "Email recipient",
          "maxLength": 200
        },
        "sender": {
          "type": "string",
          "description": "Email sender address",
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "description": "Email subject header",
          "maxLength": 300
        },
        "htmlBody": {
          "type": "string",
          "description": "Rendered HTML email template",
          "maxLength": 100000
        },
        "type": {
          "type": "string",
          "description": "Type of email",
          "enum": ["customer_confirmation", "admin_notification"],
          "maxLength": 50
        },
        "sentAt": {
          "type": "string",
          "description": "ISO timestamp of dispatch",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Delivery status",
          "enum": ["Delivered", "Sent"],
          "maxLength": 50
        }
      },
      "required": ["id", "leadId", "recipient", "sender", "subject", "htmlBody", "type", "sentAt", "status"]
    },
    "VideoItem": {
      "title": "VideoItem",
      "description": "Video briefing item displayed on the Simply Biz front-end showcase and managed in Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the video",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Display title of the video",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Summary description shown beside the video player",
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "description": "Topic category label",
          "maxLength": 100
        },
        "videoUrl": {
          "type": "string",
          "description": "Server stream path, public MP4 URL, or embed URL",
          "maxLength": 2000
        },
        "sourceType": {
          "type": "string",
          "description": "Origin type of the video",
          "enum": ["local", "uploaded", "url", "embed"],
          "maxLength": 20
        },
        "fileName": {
          "type": "string",
          "description": "Original uploaded filename",
          "maxLength": 300
        },
        "fileSizeBytes": {
          "type": "number",
          "description": "File size in bytes"
        },
        "orientation": {
          "type": "string",
          "description": "Player aspect orientation",
          "enum": ["auto", "portrait", "landscape"],
          "maxLength": 20
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the video is visible on the public website"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether the video is selected as the primary featured video"
        },
        "order": {
          "type": "number",
          "description": "Display sort order"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 100
        }
      },
      "required": ["id", "title", "videoUrl", "sourceType", "orientation", "isActive", "isFeatured", "order", "createdAt"]
    },
    "VideoSectionContent": {
      "title": "VideoSectionContent",
      "description": "Editable copy for the front-end video showcase section",
      "type": "object",
      "properties": {
        "badgeText": {
          "type": "string",
          "description": "Section kicker text",
          "maxLength": 100
        },
        "headline": {
          "type": "string",
          "description": "Section headline",
          "maxLength": 300
        },
        "subheadline": {
          "type": "string",
          "description": "Section intro paragraph",
          "maxLength": 2000
        }
      },
      "required": ["badgeText", "headline", "subheadline"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of customer quote inquiries across all browsers and devices"
    },
    "/emailLogs/{emailLogId}": {
      "schema": "EmailLog",
      "description": "Collection of dispatched email logs and audit records"
    },
    "/videos/{videoId}": {
      "schema": "VideoItem",
      "description": "Collection of front-end video showcase items synchronized across all browsers"
    },
    "/siteConfig/{configId}": {
      "schema": "VideoSectionContent",
      "description": "Shared site configuration documents such as videoSection copy"
    }
  }
}

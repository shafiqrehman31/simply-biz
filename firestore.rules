rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLead(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && data.jurisdiction is string && data.jurisdiction.size() <= 50
        && data.activityType is string && data.activityType.size() <= 200
        && data.visasNeeded is number && data.visasNeeded >= 0 && data.visasNeeded <= 1000
        && data.status is string && data.status.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 100
        && (!('company' in data) || (data.company is string && data.company.size() <= 200))
        && (!('message' in data) || (data.message is string && data.message.size() <= 5000))
        && (!('budget' in data) || (data.budget is string && data.budget.size() <= 100))
        && (!('pipedriveStatus' in data) || (data.pipedriveStatus is string && data.pipedriveStatus.size() <= 50))
        && (!('pipedriveDealId' in data) || data.pipedriveDealId == null || (data.pipedriveDealId is string && data.pipedriveDealId.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll(['id', 'leadId', 'recipient', 'sender', 'subject', 'htmlBody', 'type', 'sentAt', 'status'])
        && data.keys().hasOnly(['id', 'leadId', 'recipient', 'sender', 'subject', 'htmlBody', 'type', 'sentAt', 'status', 'deliveryNote'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.leadId is string && data.leadId.size() > 0 && data.leadId.size() <= 128
        && data.recipient is string && data.recipient.size() <= 300
        && data.sender is string && data.sender.size() <= 200
        && data.subject is string && data.subject.size() <= 300
        && data.htmlBody is string && data.htmlBody.size() <= 100000
        && data.type is string && (data.type == 'customer_confirmation' || data.type == 'admin_notification')
        && data.sentAt is string && data.sentAt.size() <= 100
        && data.status is string && (data.status == 'Delivered' || data.status == 'Sent' || data.status == 'Pending Activation' || data.status == 'Failed')
        && (!('deliveryNote' in data) || data.deliveryNote == null || (data.deliveryNote is string && data.deliveryNote.size() <= 500));
    }

    function isValidVideoItem(data) {
      return data.keys().hasAll(['id', 'title', 'videoUrl', 'sourceType', 'orientation', 'isActive', 'isFeatured', 'order', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'category', 'videoUrl', 'sourceType', 'fileName', 'fileSizeBytes', 'orientation', 'isActive', 'isFeatured', 'order', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 2000
        && data.sourceType is string && (data.sourceType == 'local' || data.sourceType == 'uploaded' || data.sourceType == 'url' || data.sourceType == 'embed')
        && (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 300))
        && (!('fileSizeBytes' in data) || data.fileSizeBytes == null || (data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 2147483648))
        && data.orientation is string && (data.orientation == 'auto' || data.orientation == 'portrait' || data.orientation == 'landscape')
        && data.isActive is bool
        && data.isFeatured is bool
        && data.order is number && data.order >= 0 && data.order <= 10000
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 100;
    }

    function isValidVideoSectionContent(data) {
      return data.keys().hasAll(['badgeText', 'headline', 'subheadline'])
        && data.keys().hasOnly(['badgeText', 'headline', 'subheadline'])
        && data.badgeText is string && data.badgeText.size() <= 100
        && data.headline is string && data.headline.size() > 0 && data.headline.size() <= 300
        && data.subheadline is string && data.subheadline.size() <= 2000;
    }

    function isValidVideoDefaults(data) {
      return data.keys().hasAll(['seeded'])
        && data.keys().hasOnly(['seeded'])
        && data.seeded is bool;
    }

    function isValidEmailSettings(data) {
      return data.keys().hasAll(['enabled', 'notificationEmails', 'fromName', 'subjectPrefix', 'deliveryProvider'])
        && data.keys().hasOnly(['enabled', 'notificationEmails', 'fromName', 'subjectPrefix', 'deliveryProvider', 'web3formsAccessKey', 'emailjsServiceId', 'emailjsTemplateId', 'emailjsCustomerTemplateId', 'emailjsPublicKey', 'webhookUrl', 'updatedAt'])
        && data.enabled is bool
        && data.notificationEmails is string && data.notificationEmails.size() <= 500
        && data.fromName is string && data.fromName.size() <= 120
        && data.subjectPrefix is string && data.subjectPrefix.size() <= 100
        && data.deliveryProvider is string && (
          data.deliveryProvider == 'formsubmit' ||
          data.deliveryProvider == 'google_apps_script' ||
          data.deliveryProvider == 'web3forms' ||
          data.deliveryProvider == 'emailjs' ||
          data.deliveryProvider == 'webhook' ||
          data.deliveryProvider == 'server_smtp'
        )
        && (!('web3formsAccessKey' in data) || (data.web3formsAccessKey is string && data.web3formsAccessKey.size() <= 200))
        && (!('emailjsServiceId' in data) || (data.emailjsServiceId is string && data.emailjsServiceId.size() <= 150))
        && (!('emailjsTemplateId' in data) || (data.emailjsTemplateId is string && data.emailjsTemplateId.size() <= 150))
        && (!('emailjsCustomerTemplateId' in data) || (data.emailjsCustomerTemplateId is string && data.emailjsCustomerTemplateId.size() <= 150))
        && (!('emailjsPublicKey' in data) || (data.emailjsPublicKey is string && data.emailjsPublicKey.size() <= 150))
        && (!('webhookUrl' in data) || (data.webhookUrl is string && data.webhookUrl.size() <= 500))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidBranding(data) {
      return data.keys().hasAll(['siteName', 'tagline', 'siteEmail', 'sitePhone', 'whatsappNumber', 'address', 'logoUrl', 'logoWhiteUrl', 'faviconUrl', 'primaryColor', 'accentColor'])
        && data.keys().hasOnly(['siteName', 'tagline', 'siteEmail', 'sitePhone', 'whatsappNumber', 'address', 'logoUrl', 'logoWhiteUrl', 'faviconUrl', 'primaryColor', 'accentColor', 'facebookUrl', 'instagramUrl', 'linkedinUrl', 'updatedAt'])
        && data.siteName is string && data.siteName.size() > 0 && data.siteName.size() <= 200
        && data.tagline is string && data.tagline.size() <= 300
        && data.siteEmail is string && data.siteEmail.size() <= 200
        && data.sitePhone is string && data.sitePhone.size() <= 50
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 50
        && data.address is string && data.address.size() <= 500
        && data.logoUrl is string && data.logoUrl.size() <= 500000
        && data.logoWhiteUrl is string && data.logoWhiteUrl.size() <= 500000
        && data.faviconUrl is string && data.faviconUrl.size() <= 500000
        && data.primaryColor is string && data.primaryColor.size() <= 50
        && data.accentColor is string && data.accentColor.size() <= 50
        && (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 500))
        && (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 500))
        && (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 500))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidHeroSlidesDoc(data) {
      return data.keys().hasAll(['items'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is list
        && data.items.size() >= 1 && data.items.size() <= 30
        && data.items[0] is map
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidServicesDoc(data) {
      return data.keys().hasAll(['items'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is list
        && data.items.size() >= 1 && data.items.size() <= 100
        && data.items[0] is map
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidFaqsDoc(data) {
      return data.keys().hasAll(['items'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is list
        && data.items.size() >= 1 && data.items.size() <= 100
        && data.items[0] is map
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidTestimonialsDoc(data) {
      return data.keys().hasAll(['items'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is list
        && data.items.size() >= 1 && data.items.size() <= 100
        && data.items[0] is map
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidAboutContent(data) {
      return data.keys().hasAll(['badgeText', 'headline', 'subheadline', 'imageUrl', 'guidingPrincipleTitle', 'guidingPrincipleText', 'guidingPrincipleBullets', 'pillars'])
        && data.keys().hasOnly(['badgeText', 'headline', 'subheadline', 'imageUrl', 'guidingPrincipleTitle', 'guidingPrincipleText', 'guidingPrincipleBullets', 'pillars', 'updatedAt'])
        && data.badgeText is string && data.badgeText.size() <= 100
        && data.headline is string && data.headline.size() > 0 && data.headline.size() <= 300
        && data.subheadline is string && data.subheadline.size() <= 2000
        && data.imageUrl is string && data.imageUrl.size() <= 500000
        && data.guidingPrincipleTitle is string && data.guidingPrincipleTitle.size() <= 300
        && data.guidingPrincipleText is string && data.guidingPrincipleText.size() <= 2000
        && data.guidingPrincipleBullets is list && data.guidingPrincipleBullets.size() <= 20
        && (data.guidingPrincipleBullets.size() == 0 || data.guidingPrincipleBullets[0] is string)
        && data.pillars is list && data.pillars.size() <= 20
        && (data.pillars.size() == 0 || data.pillars[0] is map)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidWhyUsContent(data) {
      return data.keys().hasAll(['badgeText', 'headline', 'subheadline', 'guaranteeTitle', 'guaranteeDesc', 'steps'])
        && data.keys().hasOnly(['badgeText', 'headline', 'subheadline', 'guaranteeTitle', 'guaranteeDesc', 'steps', 'updatedAt'])
        && data.badgeText is string && data.badgeText.size() <= 100
        && data.headline is string && data.headline.size() > 0 && data.headline.size() <= 300
        && data.subheadline is string && data.subheadline.size() <= 2000
        && data.guaranteeTitle is string && data.guaranteeTitle.size() <= 300
        && data.guaranteeDesc is string && data.guaranteeDesc.size() <= 2000
        && data.steps is list && data.steps.size() <= 30
        && (data.steps.size() == 0 || data.steps[0] is map)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidServicesContent(data) {
      return data.keys().hasAll(['badgeText', 'headline', 'subheadline', 'estimatorNote'])
        && data.keys().hasOnly(['badgeText', 'headline', 'subheadline', 'estimatorNote', 'updatedAt'])
        && data.badgeText is string && data.badgeText.size() <= 100
        && data.headline is string && data.headline.size() > 0 && data.headline.size() <= 300
        && data.subheadline is string && data.subheadline.size() <= 2000
        && data.estimatorNote is string && data.estimatorNote.size() <= 2000
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Leads Collection: Public inquiries & Admin management
    match /leads/{leadId} {
      allow read: if true;
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow update: if isValidId(leadId) && isValidLead(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Email Logs Collection: Audit trail of dispatched customer and admin emails
    match /emailLogs/{emailLogId} {
      allow read: if true;
      allow create: if isValidId(emailLogId) && isValidEmailLog(incoming());
      allow update, delete: if false;
    }

    // Videos Collection: Cross-browser video showcase catalog
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isValidId(videoId) && isValidVideoItem(incoming()) && incoming().id == videoId;
      allow update: if isValidId(videoId)
        && isValidVideoItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'videoUrl', 'sourceType', 'fileName', 'fileSizeBytes', 'orientation', 'isActive', 'isFeatured', 'order']);
      allow delete: if isValidId(videoId);
    }

    // Site Config Collection: Shared CMS content, video section copy, seed state, and email notification settings
    match /siteConfig/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && (
        (configId == 'videoSection' && isValidVideoSectionContent(incoming())) ||
        (configId == 'videoDefaults' && isValidVideoDefaults(incoming())) ||
        (configId == 'emailSettings' && isValidEmailSettings(incoming())) ||
        (configId == 'branding' && isValidBranding(incoming())) ||
        (configId == 'heroSlides' && isValidHeroSlidesDoc(incoming())) ||
        (configId == 'services' && isValidServicesDoc(incoming())) ||
        (configId == 'faqs' && isValidFaqsDoc(incoming())) ||
        (configId == 'testimonials' && isValidTestimonialsDoc(incoming())) ||
        (configId == 'aboutContent' && isValidAboutContent(incoming())) ||
        (configId == 'whyUsContent' && isValidWhyUsContent(incoming())) ||
        (configId == 'servicesContent' && isValidServicesContent(incoming()))
      );
      allow delete: if false;
    }
  }
}

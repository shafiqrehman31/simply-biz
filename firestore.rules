rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLead(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && data.jurisdiction is string && data.jurisdiction.size() <= 50
        && data.activityType is string && data.activityType.size() <= 200
        && data.visasNeeded is number && data.visasNeeded >= 0 && data.visasNeeded <= 1000
        && data.status is string && data.status.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 100
        && (!('company' in data) || (data.company is string && data.company.size() <= 200))
        && (!('message' in data) || (data.message is string && data.message.size() <= 5000))
        && (!('budget' in data) || (data.budget is string && data.budget.size() <= 100))
        && (!('pipedriveStatus' in data) || (data.pipedriveStatus is string && data.pipedriveStatus.size() <= 50))
        && (!('pipedriveDealId' in data) || data.pipedriveDealId == null || (data.pipedriveDealId is string && data.pipedriveDealId.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidEmailLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.leadId is string && data.leadId.size() <= 128
        && data.recipient is string && data.recipient.size() <= 200
        && data.sender is string && data.sender.size() <= 200
        && data.subject is string && data.subject.size() <= 300
        && data.htmlBody is string && data.htmlBody.size() <= 100000
        && data.type is string && (data.type == 'customer_confirmation' || data.type == 'admin_notification')
        && data.sentAt is string && data.sentAt.size() <= 100
        && data.status is string && (data.status == 'Delivered' || data.status == 'Sent');
    }

    function isValidVideoItem(data) {
      return data.keys().hasAll(['id', 'title', 'videoUrl', 'sourceType', 'orientation', 'isActive', 'isFeatured', 'order', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'category', 'videoUrl', 'sourceType', 'fileName', 'fileSizeBytes', 'orientation', 'isActive', 'isFeatured', 'order', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 2000
        && data.sourceType is string && (data.sourceType == 'local' || data.sourceType == 'uploaded' || data.sourceType == 'url' || data.sourceType == 'embed')
        && (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 300))
        && (!('fileSizeBytes' in data) || data.fileSizeBytes == null || (data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 2147483648))
        && data.orientation is string && (data.orientation == 'auto' || data.orientation == 'portrait' || data.orientation == 'landscape')
        && data.isActive is bool
        && data.isFeatured is bool
        && data.order is number && data.order >= 0 && data.order <= 10000
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 100;
    }

    function isValidVideoSectionContent(data) {
      return data.keys().hasAll(['badgeText', 'headline', 'subheadline'])
        && data.keys().hasOnly(['badgeText', 'headline', 'subheadline'])
        && data.badgeText is string && data.badgeText.size() <= 100
        && data.headline is string && data.headline.size() > 0 && data.headline.size() <= 300
        && data.subheadline is string && data.subheadline.size() <= 2000;
    }

    function isValidVideoDefaults(data) {
      return data.keys().hasAll(['seeded'])
        && data.keys().hasOnly(['seeded'])
        && data.seeded is bool;
    }

    // Leads Collection: Public inquiries & Admin management
    match /leads/{leadId} {
      allow read: if true;
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow update: if isValidId(leadId) && isValidLead(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Email Logs Collection: Audit trail of dispatched customer and admin emails
    match /emailLogs/{emailLogId} {
      allow read: if true;
      allow create: if isValidId(emailLogId) && isValidEmailLog(incoming());
      allow update, delete: if false;
    }

    // Videos Collection: Cross-browser video showcase catalog
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isValidId(videoId) && isValidVideoItem(incoming()) && incoming().id == videoId;
      allow update: if isValidId(videoId)
        && isValidVideoItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'videoUrl', 'sourceType', 'fileName', 'fileSizeBytes', 'orientation', 'isActive', 'isFeatured', 'order']);
      allow delete: if isValidId(videoId);
    }

    // Site Config Collection: Shared video section copy and catalog seed state
    match /siteConfig/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && (
        (configId == 'videoSection' && isValidVideoSectionContent(incoming())) ||
        (configId == 'videoDefaults' && isValidVideoDefaults(incoming()))
      );
      allow delete: if false;
    }
  }
}
